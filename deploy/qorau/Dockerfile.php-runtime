# Runtime-only update: retain the exact deployed application and vendor tree.
ARG DOSMART_PREVIOUS_IMAGE=dosmart-app:compactprint20261022
FROM ${DOSMART_PREVIOUS_IMAGE} AS deployed
FROM php:8.3.36-fpm-alpine3.24@sha256:aaf1ad25fc6484613be770743d1038e98e3e7e07409d78b97410eccdf3628f75
RUN apk add --no-cache libpq-dev icu-dev icu-data-full unzip \
    && docker-php-ext-install -j2 pdo_pgsql intl
COPY --from=deployed /usr/bin/composer /usr/bin/composer
COPY --from=deployed /usr/local/etc/php-fpm.conf /usr/local/etc/php-fpm.conf
COPY --from=deployed /usr/local/etc/php-fpm.d/ /usr/local/etc/php-fpm.d/
RUN printf 'session.upload_progress.enabled=Off\n' > /usr/local/etc/php/conf.d/zz-dosmart-security.ini
WORKDIR /var/www/html
COPY --from=deployed /var/www/html/ /var/www/html/
USER www-data
EXPOSE 9000
CMD ["php-fpm"]
