{$SITE_DOMAIN} {
    root * /var/www/html/public
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options SAMEORIGIN
        Strict-Transport-Security "max-age=31536000"
    }
    php_fastcgi app:9000 {
        env HTTPS on
    }
    file_server
}
